---
import { Image } from "astro:assets";
import { ArrowUpRight } from "lucide-react";
import { FaGithub } from "react-icons/fa";
import { FaXTwitter } from "react-icons/fa6";
import appIcon from "../assets/app-icon.png";
import { currentRelease } from "../data/currentRelease";
import {
  getLangFromUrl,
  useTranslatedPath,
  useTranslations,
} from "../i18n/utils";
import { authorLinks } from "../lib/author";
import { githubRepoUrl } from "../lib/github";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { translatePath } = useTranslatedPath(lang);
const downloadHref = translatePath("/download");
const aboutHref = translatePath("/about");
const privacyHref = translatePath("/privacy");
const currentYear = new Date().getFullYear();

const footerLinks = [
  {
    title: t("footer.product"),
    links: [
      { name: t("footer.features"), href: translatePath("/#features") },
      {
        name: t("nav.coolingInsight"),
        href: translatePath("/cooling-insight"),
      },
      { name: t("footer.download"), href: downloadHref },
      { name: t("footer.specs"), href: translatePath("/specs") },
      { name: t("footer.compare"), href: translatePath("/compare") },
      { name: t("footer.changelog"), href: translatePath("/changelog") },
      {
        name: t(currentRelease.navKey),
        href: translatePath(`/releases/${currentRelease.slug}`),
      },
    ],
  },
  {
    title: t("footer.resources"),
    links: [
      { name: t("nav.guide"), href: translatePath("/guide") },
      { name: t("footer.faq"), href: translatePath("/faq") },
      { name: t("footer.security"), href: translatePath("/security") },
      {
        name: t("download.nav.verification"),
        href: translatePath("/verification"),
      },
    ],
  },
  {
    title: t("footer.community"),
    links: [
      { name: t("footer.github"), href: githubRepoUrl(), external: true },
      {
        name: t("footer.discussions"),
        href: `${githubRepoUrl()}/discussions`,
        external: true,
      },
      {
        name: t("footer.survey"),
        href: `${translatePath("/survey")}?source=web`,
      },
      {
        name: t("footer.reportIssue"),
        href: `${githubRepoUrl()}/issues`,
        external: true,
      },
    ],
  },
];
---

<footer class="pt-[clamp(2rem,4vw,3.5rem)] pb-10">
  <div class="shell">
    <div
      class="panel grid gap-10 md:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] md:gap-16 md:p-10"
    >
      <div>
        <div class="flex items-center gap-2.5">
          <Image src={appIcon} alt="" class="h-7 w-7" />
          <span class="font-bold text-foreground text-lg"
            >HardwareVisualizer</span
          >
        </div>
        <p class="mt-4 text-muted-foreground text-sm">
          {t("footer.description")}
        </p>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
        {footerLinks.map((section) => (
            <div>
              <h3 class="font-bold text-foreground text-sm">{section.title}</h3>
              <ul class="mt-3 space-y-2 text-sm">
                {section.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="inline-flex items-center gap-1 text-muted-foreground transition-colors hover:text-foreground"
                      {...("external" in link && link.external
                        ? { target: "_blank", rel: "noopener noreferrer" }
                        : { "data-astro-prefetch": true })}
                    >
                      {link.name}
                      {"external" in link && link.external ? (
                        <ArrowUpRight className="h-3.5 w-3.5" aria-hidden="true" />
                      ) : null}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
      </div>
    </div>

    <div
      class="flex flex-col items-start justify-between gap-4 px-2 pt-6 sm:flex-row sm:items-center"
    >
      <p class="text-muted-foreground text-sm">
        © 2024–{currentYear}
        shm11C3 · HardwareVisualizer
      </p>
      <div class="flex items-center gap-5 text-sm">
        <a
          href={aboutHref}
          class="text-muted-foreground transition-colors hover:text-foreground"
          data-astro-prefetch
        >
          {t("footer.about")}
        </a>
        <a
          href={privacyHref}
          class="text-muted-foreground transition-colors hover:text-foreground"
          data-astro-prefetch
        >
          {t("footer.privacy")}
        </a>
        <a
          href={authorLinks.github}
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted-foreground transition-colors hover:text-foreground"
          aria-label="shm11C3 on GitHub"
        >
          <FaGithub className="h-[18px] w-[18px]" />
        </a>
        <a
          href={authorLinks.x}
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted-foreground transition-colors hover:text-foreground"
          aria-label="X (Twitter)"
        >
          <FaXTwitter className="h-[18px] w-[18px]" />
        </a>
      </div>
    </div>
  </div>
</footer>
