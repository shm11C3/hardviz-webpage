---
import {
  getLangFromUrl,
  useTranslatedPath,
  useTranslations,
} from "../i18n/utils";
import { addJapaneseLineBreaks } from "../lib/japaneseLineBreaks";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { translatePath } = useTranslatedPath(lang);
---

<aside
  class:list={["license-notice", lang === "ja" && "budoux-ja"]}
  aria-labelledby="winget-license-notice-title"
>
  <h2 id="winget-license-notice-title">
    {addJapaneseLineBreaks(lang, t("licenseNotice.title"))}
  </h2>
  <p>{addJapaneseLineBreaks(lang, t("licenseNotice.body"))}</p>
  <a href={`${translatePath("/changelog/1.11.0")}#winget-license-notice`}>
    {t("licenseNotice.link")}
  </a>
</aside>

<style>
.license-notice {
  border: 1px dashed var(--input);
  border-radius: 0.75rem;
  padding: 0.875rem 1rem;
  color: var(--muted-foreground);
  font-size: 0.8125rem;
  line-height: 1.75;
}
h2 {
  margin: 0 0 0.25rem;
  color: var(--foreground);
  font-size: 0.875rem;
  font-weight: 600;
}
p {
  margin: 0 0 0.375rem;
}
a {
  color: var(--foreground);
  font-weight: 500;
  text-decoration: underline;
  text-decoration-color: var(--muted-foreground);
  text-underline-offset: 4px;
}
a:hover {
  text-decoration-color: var(--foreground);
}
</style>
