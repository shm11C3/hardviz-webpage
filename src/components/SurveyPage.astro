---
import { ArrowLeft } from "lucide-react";
import {
  getLangFromUrl,
  useTranslatedPath,
  useTranslations,
} from "../i18n/utils";
import {
  buildSurveyEmbedSrc,
  buildSurveyFormUrl,
  getSurveyFormId,
  isSurveyConfigured,
  SURVEY_FORWARDED_PARAMS,
} from "../lib/survey";
import ClauseText from "./ClauseText.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { translatePath } = useTranslatedPath(lang);
const privacyHref = translatePath("/privacy");
const homeHref = translatePath("/");

const configured = isSurveyConfigured(lang);
const formId = configured ? getSurveyFormId(lang) : "";
const embedSrc = configured ? buildSurveyEmbedSrc(formId) : "";
const formUrl = configured ? buildSurveyFormUrl(formId) : "";
const forwardedParams = [...SURVEY_FORWARDED_PARAMS];
// Defaults used when a param is absent from the page URL: `locale` follows the
// page language and `source` falls back to "web". Explicit query params (e.g.
// the app's source=app) still override these. app_version/os have no web
// default — they only arrive when the app opens the survey.
const paramDefaults = { locale: lang, source: "web" };
---

<section class="section">
  <div class="shell">
    <div class="section-head">
      <h1 class="section-title">{t("survey.heading")}</h1>
      <p class="lead">
        <ClauseText lang={lang} text={t("survey.description")} />
      </p>
      <p class="text-muted-foreground mx-auto mt-3 max-w-[38em] text-sm">
        {t("survey.privacyNote")}{" "}
        <a href={privacyHref} class="link" data-astro-prefetch>
          {t("survey.privacyNoteLink")}
        </a>
      </p>
    </div>

    <div class="mx-auto mt-[clamp(1.5rem,3vw,2.5rem)] max-w-3xl">
      {configured ? (
        <>
          {/* The form is drawn for a light background, so its frame stays white in both themes. */}
          <div class="border-border overflow-hidden rounded-[var(--radius-lg)] border bg-white">
            <iframe
              id="survey-frame"
              data-tally-src={embedSrc}
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              title={t("survey.heading")}
              class="block w-full"
              style="min-height: 640px;"
            />
          </div>
          <p class="text-muted-foreground mt-3 text-center text-sm">
            {t("survey.fallback")}{" "}
            <a
              id="survey-form-link"
              href={formUrl}
              class="link"
              target="_blank"
              rel="noopener noreferrer"
            >
              {t("survey.fallbackLink")}
            </a>
          </p>
        </>
      ) : (
        <div class="panel text-muted-foreground text-center">
          {t("survey.preparing")}
        </div>
      )}

      <div class="mt-10 text-center">
        <a href={homeHref} class="btn btn-sm btn-outline" data-astro-prefetch>
          <ArrowLeft aria-hidden="true" className="h-4 w-4" />
          {t("survey.backHome")}
        </a>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ forwardedParams, paramDefaults }}>
(() => {
  const iframe = document.getElementById("survey-frame");
  if (!iframe) return;

  // Forward whitelisted, non-identifying context (SURVEY_FORWARDED_PARAMS in
  // src/lib/survey.ts) into the Tally embed URL so it lands in the form's
  // hidden fields. Values come from the page URL, falling back to
  // paramDefaults (locale = page language, source = "web"). The link that
  // opens the form on Tally gets the same values.
  const current = new URLSearchParams(window.location.search);
  const withContext = (raw) => {
    try {
      const url = new URL(raw);
      for (const key of forwardedParams) {
        const value = current.get(key) ?? paramDefaults[key];
        if (value) url.searchParams.set(key, value);
      }
      return url.toString();
    } catch {
      return raw;
    }
  };

  const base = iframe.getAttribute("data-tally-src");
  if (base) iframe.setAttribute("data-tally-src", withContext(base));
  const formLink = document.getElementById("survey-form-link");
  const formHref = formLink?.getAttribute("href");
  if (formLink && formHref)
    formLink.setAttribute("href", withContext(formHref));

  const apply = () => {
    if (window.Tally && typeof window.Tally.loadEmbeds === "function") {
      window.Tally.loadEmbeds();
      return;
    }
    // Fallback if Tally's script is unavailable: load the form directly.
    for (const el of document.querySelectorAll("iframe[data-tally-src]")) {
      if (!el.src) el.src = el.getAttribute("data-tally-src");
    }
  };

  if (window.Tally) {
    apply();
    return;
  }
  const existing = document.querySelector(
    'script[src="https://tally.so/widgets/embed.js"]',
  );
  if (existing) {
    existing.addEventListener("load", apply);
    existing.addEventListener("error", apply);
    return;
  }
  const script = document.createElement("script");
  script.src = "https://tally.so/widgets/embed.js";
  script.onload = apply;
  script.onerror = apply;
  document.body.appendChild(script);
})();
</script>
