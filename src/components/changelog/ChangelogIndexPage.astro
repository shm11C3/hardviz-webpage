---
import { FaGithub } from "react-icons/fa";
import {
  getLangFromUrl,
  useTranslatedPath,
  useTranslations,
} from "../../i18n/utils";
import Layout from "../../layouts/Layout.astro";
import {
  getChangelogEntries,
  getChangelogEntriesForJaIndex,
} from "../../lib/changelog";
import { githubAllReleasesUrl, githubReleaseTagUrl } from "../../lib/github";
import Footer from "../Footer.astro";
import Header from "../Header.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { translatePath } = useTranslatedPath(lang);

const isJa = lang === "ja";

const entries = isJa
  ? await getChangelogEntriesForJaIndex()
  : (await getChangelogEntries("en")).map((entry) => ({
      entry,
      untranslated: false,
    }));

const dateFormatter = new Intl.DateTimeFormat(isJa ? "ja-JP" : "en-US", {
  year: "numeric",
  month: isJa ? "long" : "short",
  day: isJa ? "numeric" : "2-digit",
});
---

<Layout
  title={`HardwareVisualizer - ${t("changelog.title")}`}
  lang={isJa ? "ja" : "en"}
  description={t("changelog.description")}
>
  <Header />

  <main id="main-content" class="pt-28 pb-20">
    <div class="shell split">
      <header>
        <h1 class="font-bold text-3xl text-foreground md:text-4xl">
          {t("changelog.title")}
        </h1>
        <p class="mt-4 text-muted-foreground">{t("changelog.description")}</p>
        <a
          href={githubAllReleasesUrl()}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline mt-6"
        >
          <FaGithub className="h-[18px] w-[18px]" aria-hidden="true" />
          {t("download.githubLink")}
        </a>
        <p class="mt-4 text-sm">
          <a href={`${translatePath("/changelog")}rss.xml`} class="link">
            {t("changelog.rss")}
          </a>
        </p>
      </header>

      <div class="min-w-0">
        <p class="note mb-3">{t("changelog.announcement")}</p>

        {entries.length ? (
            <ol class="panel ruled">
              {entries.map(({ entry, untranslated }) => (
                <li>
                  <article class="changelog-row">
                    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 text-muted-foreground text-sm">
                      {entry.data.title !== `v${entry.data.version}` ? (
                        <span class="font-mono text-foreground">v{entry.data.version}</span>
                      ) : null}
                      <time datetime={entry.data.date.toISOString()}>
                        {dateFormatter.format(entry.data.date)}
                      </time>
                      {untranslated ? (
                        <span class="rounded-sm border border-amber-300 px-1.5 py-0.5 text-amber-800 text-xs dark:border-amber-400/40 dark:text-amber-200">
                          {t("changelog.untranslatedBadge")}
                        </span>
                      ) : null}
                    </div>

                    <h2 class="item-title mt-1.5">
                      <a
                        href={translatePath(`/changelog/${entry.data.version}`)}
                        data-astro-prefetch
                        aria-label={`${t("changelog.title")} v${entry.data.version}`}
                        class="changelog-link"
                      >
                        {entry.data.title}
                      </a>
                    </h2>

                    {entry.data.summary ? (
                      <p class="item-body max-w-[68ch]">{entry.data.summary}</p>
                    ) : null}

                    {entry.data.tags?.length ? (
                      <div class="mt-3 flex flex-wrap gap-2">
                        {entry.data.tags.map((tag) => (
                          <span class="badge">
                            {tag}
                          </span>
                        ))}
                      </div>
                    ) : null}

                    <div class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm">
                      <a
                        href={githubReleaseTagUrl(entry.data.version)}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="link"
                      >
                        {t("changelog.githubRelease")}
                      </a>
                      {entry.data.links?.map((link) => (
                        <a
                          href={link.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="link"
                        >
                          {link.label}
                        </a>
                      ))}
                    </div>
                  </article>
                </li>
              ))}
            </ol>
          ) : (
            <div class="border-border border-t pt-5">
              <p class="item-title">{t("changelog.emptyTitle")}</p>
              <p class="item-body">{t("changelog.emptyDescription")}</p>
            </div>
          )}
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
.changelog-link {
  text-decoration: underline;
  text-decoration-color: var(--input);
  text-decoration-thickness: 1px;
  text-underline-offset: 0.25em;
  transition: text-decoration-color 120ms;
}
.changelog-link:hover {
  text-decoration-color: var(--foreground);
}
</style>
