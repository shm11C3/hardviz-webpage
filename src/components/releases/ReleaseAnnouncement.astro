---
import { currentRelease } from "../../data/currentRelease";
import {
  getLangFromUrl,
  useTranslatedPath,
  useTranslations,
} from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { translatePath } = useTranslatedPath(lang);
---

<aside class="release-announcement">
  <a
    href={translatePath(`/releases/${currentRelease.slug}`)}
    data-release-version={currentRelease.version}
    >{t(currentRelease.announcementKey)}</a
  >
</aside>
<script is:inline>
// Report clicks on the homepage announcement so the release article's reach can
// be compared with the download CTAs tracked by LandingDownloadAnalytics.
document.addEventListener("click", (event) => {
  if (!(event.target instanceof Element)) return;
  const link = event.target.closest(".release-announcement a");
  if (!(link instanceof HTMLAnchorElement)) return;
  if (!window.__analyticsLoaded || typeof window.gtag !== "function") return;
  window.gtag("event", "release_announcement_click", {
    release_version: link.dataset.releaseVersion,
    page_language: document.documentElement.lang,
    transport_type: "beacon",
  });
});
</script>
<style>
.release-announcement {
  padding: 18px 24px;
  text-align: center;
  background: #f0f5fa;
  color: #1768ac;
  font: 500 0.9rem / 1.8 var(--font-sans);
}
a {
  text-decoration: underline;
  text-underline-offset: 5px;
}
:global(.dark) .release-announcement {
  background: #192c42;
  color: #a0cef5;
}
</style>
