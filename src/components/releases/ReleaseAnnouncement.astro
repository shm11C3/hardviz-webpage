---
import {
  getLangFromUrl,
  useTranslatedPath,
  useTranslations,
} from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { translatePath } = useTranslatedPath(lang);
---

<aside class="release-announcement">
  <a href={translatePath("/releases/cooling-insight")}
    >{t("release.announcement")}</a
  >
</aside>
<style>
.release-announcement {
  padding: 18px 24px;
  text-align: center;
  background: #f0f5fa;
  color: #1768ac;
  font: 500 0.9rem / 1.8 var(--font-sans);
}
a {
  text-decoration: underline;
  text-underline-offset: 5px;
}
:global(.dark) .release-announcement {
  background: #192c42;
  color: #a0cef5;
}
</style>
