---
import { Image } from "astro:assets";
import { FaGithub } from "react-icons/fa";
import coolingEn from "../assets/releases/cooling-insight-en.png";
import coolingJa from "../assets/releases/cooling-insight-ja.png";
import coolingLightEn from "../assets/releases/cooling-insight-light-en.png";
import coolingLightJa from "../assets/releases/cooling-insight-light-ja.png";
import performanceEn from "../assets/screenshots/dashboard-performance-en.png";
import performanceJa from "../assets/screenshots/dashboard-performance-ja.png";
import performanceLightEn from "../assets/screenshots/dashboard-performance-light-en.png";
import performanceLightJa from "../assets/screenshots/dashboard-performance-light-ja.png";
import insights from "../assets/screenshots/slide-2.png";
import insightsLight from "../assets/screenshots/slide-2-l.png";
import {
  getLangFromUrl,
  useTranslatedPath,
  useTranslations,
} from "../i18n/utils";
import { githubRepoUrl } from "../lib/github";
import { addJapaneseLineBreaks } from "../lib/japaneseLineBreaks";
import type { Platform, PlatformDownload } from "../types/platform";

interface Props {
  /** Latest released version, without the leading "v". */
  version: string | null;
  /** The release's installers, with their direct download URLs. */
  downloads: PlatformDownload[];
}

const { version, downloads } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// Japanese copy gets BudouX phrase boundaries so lines break between phrases.
const tf = (key: Parameters<typeof t>[0]) =>
  addJapaneseLineBreaks(lang, t(key));
const { translatePath } = useTranslatedPath(lang);
const isJa = lang === "ja";

// The main button downloads the installer itself. Windows has one installer.
// A Mac gets the Apple Silicon build, and the label says so. Linux has three
// package formats, so its button goes to the download section to choose one.
const installerUrl = (type: Platform) =>
  downloads
    .flatMap((platform) => platform.versions)
    .find((version) => version.type === type)?.url ?? null;
const windowsUrl = installerUrl("windows") ?? translatePath("/download");
const macUrl = installerUrl("macOSAppleSilicon") ?? "#download";

// The three screens the tabs switch between, named as the application names
// them.
const screens = [
  {
    key: "live",
    name: t("scale.live.screen"),
    caption: tf("scale.live.caption"),
    alt: t("screenshots.dashboardAlt"),
    light: isJa ? performanceLightJa : performanceLightEn,
    dark: isJa ? performanceJa : performanceEn,
  },
  {
    key: "record",
    name: t("scale.record.screen"),
    caption: tf("scale.record.caption"),
    alt: t("screenshots.insightsAlt"),
    light: insightsLight,
    dark: insights,
  },
  {
    key: "notice",
    name: t("scale.notice.screen"),
    caption: tf("scale.notice.caption"),
    alt: t("screenshots.coolingInsightAlt"),
    light: isJa ? coolingLightJa : coolingLightEn,
    dark: isJa ? coolingJa : coolingEn,
  },
] as const;

const initial = screens[0];
const imageWidths = [640, 960, 1280, 1920];
const imageSizes = "(max-width: 1312px) 100vw, 1200px";

const facts = [
  {
    term: t("hero.facts.version"),
    value: version ? `v${version}` : "-",
    href: translatePath("/changelog"),
  },
  { term: t("hero.facts.platforms"), value: t("hero.facts.platformsValue") },
  { term: t("hero.facts.license"), value: "GPL-3.0-or-later" },
  { term: t("hero.facts.price"), value: t("hero.facts.priceValue") },
];
---

<section
  id="hero"
  aria-labelledby="hero-heading"
  class:list={["hero", isJa && "budoux-ja"]}
>
  <div class="shell">
    <h1 id="hero-heading" class="hero-title">{tf("hero.title")}</h1>
    <p class="hero-lead">{tf("hero.description")}</p>
    <div class="hero-cta">
      <a
        href={windowsUrl}
        class="btn btn-lg btn-primary"
        data-os-download
        data-direct-download="windows"
        data-label-macos={t("hero.downloadMac")}
        data-href-macos={macUrl}
        data-direct-macos="macOSAppleSilicon"
        data-label-linux={t("hero.downloadLinux")}
        data-href-linux="#download"
        data-direct-linux=""
      >
        {t("hero.download")}
      </a>
      <a
        href={githubRepoUrl()}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-lg btn-outline"
      >
        <FaGithub className="h-5 w-5" aria-hidden="true" />
        GitHub
      </a>
    </div>
    <div class="hero-notes">
      <p class="hero-winget" data-winget>
        {t("hero.winget")}
        <code>winget install shm11C3.HardwareVisualizer</code>
      </p>
      <p class="hero-links">
        <a href={translatePath("/guide")} class="link" data-astro-prefetch>
          {t("matrix.linkGuide")}
        </a>
        <a
          href="#download"
          class="link"
          data-os-others
          data-label-macos={t("hero.otherPlatformsMac")}
          data-label-linux={t("hero.otherPlatformsLinux")}
        >
          {t("hero.otherPlatforms")}
        </a>
      </p>
    </div>
    <script is:inline>
    // The main button downloads the installer for the visitor's OS and the
    // link below it names the others. The page is built for Windows, the main
    // audience, and phones keep that. On a Mac or a Linux desktop the labels
    // and the download target change and the Winget line, a Windows tool, is
    // removed. This runs before the first paint, so nothing shifts.
    (() => {
      const ua = navigator.userAgent;
      const os = /Macintosh/.test(ua)
        ? "Macos"
        : /Linux/.test(ua) && !/Android/.test(ua)
          ? "Linux"
          : null;
      if (!os) return;
      document.querySelector("[data-winget]")?.remove();
      for (const link of document.querySelectorAll(
        "[data-os-download], [data-os-others]",
      )) {
        const label = link.dataset[`label${os}`];
        if (label) link.textContent = label;
        const href = link.dataset[`href${os}`];
        if (href) {
          link.setAttribute("href", href);
          link.dataset.directDownload = link.dataset[`direct${os}`] ?? "";
        }
      }
    })();
    </script>

    <figure data-screens>
      <div class="window panel">
        <div class="window-bar">
          <div class="seg" role="tablist" aria-label={t("hero.tabsLabel")}>
            {screens.map((screen, index) => (
                <button
                  type="button"
                  role="tab"
                  id={`screen-tab-${screen.key}`}
                  aria-selected={index === 0 ? "true" : "false"}
                  aria-controls="screen-panel"
                  tabindex={index === 0 ? 0 : -1}
                  data-screenshot-tab={screen.key}
                >
                  {screen.name}
                </button>
              ))}
          </div>
          {version && <p>HardwareVisualizer v{version}</p>}
        </div>
        <div
          role="tabpanel"
          id="screen-panel"
          aria-labelledby={`screen-tab-${initial.key}`}
          class="screen"
          data-screenshot={initial.key}
        ></div>
        <noscript>
          <Image
            src={initial.light}
            alt={initial.alt}
            class="block h-auto w-full rounded-2xl"
            widths={imageWidths}
            sizes={imageSizes}
          />
        </noscript>
      </div>

      {screens.map((screen, index) => (
          <figcaption data-screenshot-caption={screen.key} hidden={index !== 0}>
            {screen.caption}
          </figcaption>
        ))}

      {screens.map((screen, index) => (
          <>
            <template data-screenshot-template={screen.key} data-theme="light">
              <Image
                src={screen.light}
                alt={screen.alt}
                widths={imageWidths}
                sizes={imageSizes}
                loading="eager"
                fetchpriority={index === 0 ? "high" : "auto"}
              />
            </template>
            <template data-screenshot-template={screen.key} data-theme="dark">
              <Image
                src={screen.dark}
                alt={screen.alt}
                widths={imageWidths}
                sizes={imageSizes}
                loading="eager"
                fetchpriority={index === 0 ? "high" : "auto"}
              />
            </template>
          </>
        ))}

      <script is:inline>
      (() => {
        const root = document.querySelector("[data-screens]");
        if (!root) return;
        const panel = root.querySelector("[role=tabpanel]");
        const tabs = Array.from(root.querySelectorAll("[data-screenshot-tab]"));
        const captions = Array.from(
          root.querySelectorAll("[data-screenshot-caption]"),
        );
        if (!panel || tabs.length === 0) return;

        let activeKey = panel.dataset.screenshot;
        let shown = "";

        const currentTheme = () =>
          document.documentElement.classList.contains("dark")
            ? "dark"
            : "light";

        // Only the screenshot for the selected screen and the active theme is
        // ever in the document, so the others are never downloaded.
        const render = () => {
          const theme = currentTheme();
          const id = `${activeKey}:${theme}`;
          if (id === shown) return;
          const template = root.querySelector(
            `template[data-screenshot-template="${activeKey}"][data-theme="${theme}"]`,
          );
          if (!(template instanceof HTMLTemplateElement)) return;
          panel.replaceChildren(template.content.cloneNode(true));
          panel.dataset.screenshot = activeKey;
          shown = id;
        };

        const select = (tab, moveFocus) => {
          activeKey = tab.dataset.screenshotTab;
          for (const other of tabs) {
            const selected = other === tab;
            other.setAttribute("aria-selected", String(selected));
            other.tabIndex = selected ? 0 : -1;
          }
          for (const caption of captions) {
            caption.hidden = caption.dataset.screenshotCaption !== activeKey;
          }
          panel.setAttribute("aria-labelledby", tab.id);
          if (moveFocus) tab.focus();
          render();
        };

        for (const tab of tabs) {
          tab.addEventListener("click", () => select(tab, false));
          tab.addEventListener("keydown", (event) => {
            const index = tabs.indexOf(tab);
            const next =
              event.key === "ArrowRight"
                ? tabs[(index + 1) % tabs.length]
                : event.key === "ArrowLeft"
                  ? tabs[(index - 1 + tabs.length) % tabs.length]
                  : event.key === "Home"
                    ? tabs[0]
                    : event.key === "End"
                      ? tabs[tabs.length - 1]
                      : null;
            if (!next) return;
            event.preventDefault();
            select(next, true);
          });
        }

        new MutationObserver(render).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ["class"],
        });
        render();
      })();
      </script>
    </figure>

    <dl class="facts panel" aria-label={t("hero.facts.label")}>
      {facts.map((fact) => (
          <div>
            <dt>{fact.term}</dt>
            <dd>
              {fact.href ? (
                <a href={fact.href} class="link" data-astro-prefetch>
                  {fact.value}
                </a>
              ) : (
                fact.value
              )}
            </dd>
          </div>
        ))}
    </dl>
  </div>
</section>

<style>
.hero {
  padding-top: clamp(2.5rem, 7vw, 6rem);
  text-align: center;
}
/* One line on a desktop, two on a phone. */
.hero-title {
  font-size: clamp(2.2rem, 5.1vw, 4.5rem);
  font-weight: 700;
  line-height: 1.2;
}
:lang(ja) .hero-title {
  font-size: clamp(2.35rem, 5.1vw, 4.5rem);
  line-height: 1.3;
  letter-spacing: 0.01em;
}
.hero-lead {
  max-width: 36em;
  margin: 1.25rem auto 0;
  color: var(--soft);
  font-size: clamp(1.0625rem, 1.7vw, 1.375rem);
  text-wrap: balance;
}
.hero-cta {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.9rem;
  margin-top: 2.25rem;
}
/* The longest label ("… (Apple Silicon)") must fit a narrow window. */
@media (max-width: 30rem) {
  .hero-cta :global(.btn) {
    max-width: 100%;
    height: auto;
    min-height: 3.4rem;
    padding-inline: 1.1rem;
    line-height: 1.4;
    text-align: center;
    white-space: normal;
  }
}
.hero-notes {
  display: grid;
  gap: 0.6rem;
  margin-top: 1.4rem;
  color: var(--muted-foreground);
  font-size: 0.8125rem;
}
.hero-links {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.4rem 1.5rem;
}
.hero-notes .link {
  color: var(--muted-foreground);
}
.hero-notes .link:hover {
  color: var(--foreground);
}
.hero-winget code {
  display: inline-block;
  margin: 0.4rem 0 0 0.5rem;
  padding: 0.2rem 0.8rem;
  border: 1px solid var(--border);
  border-radius: 9999px;
  background: var(--card);
  color: var(--foreground);
  font-family: var(--font-mono);
  white-space: nowrap;
}

/* The application screen, in a translucent frame of its own. */
.window {
  margin-top: clamp(3rem, 6vw, 4.5rem);
  padding: 0.7rem;
  box-shadow: 0 3rem 7rem -2rem var(--glow);
  text-align: left;
}
.window-bar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.75rem;
  padding: 0.35rem 0.5rem 0.9rem;
}
.window-bar p {
  display: none;
  margin-left: auto;
  color: var(--muted-foreground);
  font-size: 0.8125rem;
}
.seg {
  display: inline-flex;
  padding: 0.22rem;
  border-radius: 9999px;
  background: var(--muted);
}
.seg button {
  padding: 0.4rem 0.7rem;
  border-radius: 9999px;
  color: var(--muted-foreground);
  font-size: 0.8125rem;
  font-weight: 500;
  line-height: 1.5;
  white-space: nowrap;
  cursor: pointer;
}
.seg button[aria-selected="true"] {
  background: var(--muted-hover);
  color: var(--foreground);
}
.screen {
  overflow: hidden;
  aspect-ratio: 4 / 3;
  border-radius: 1.05rem;
  background: var(--stage);
}
.screen :global(img) {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: left top;
}
figcaption {
  max-width: 52rem;
  margin: 1rem auto 0;
  color: var(--muted-foreground);
  font-size: 0.8125rem;
}

.facts {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-top: 1.25rem;
  padding: 0;
  text-align: left;
}
.facts div {
  padding: 1.1rem 1.25rem;
}
.facts div:nth-child(even) {
  border-left: 1px solid var(--border);
}
.facts div:nth-child(n + 3) {
  border-top: 1px solid var(--border);
}
.facts dt {
  color: var(--muted-foreground);
  font-size: 0.8125rem;
}
.facts dd {
  font-size: 1.0625rem;
  font-weight: 700;
  line-height: 1.6;
}
.facts dd .link {
  font-weight: 700;
}

@media (min-width: 60rem) {
  .window-bar p {
    display: block;
  }
  .seg button {
    padding: 0.4rem 1.1rem;
    font-size: 0.875rem;
  }
  .screen {
    aspect-ratio: 16 / 9;
  }
  .facts {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .facts div {
    padding: 1.2rem 1.6rem;
  }
  .facts div:nth-child(n) {
    border-top: 0;
  }
  .facts div + div {
    border-left: 1px solid var(--border);
  }
}
</style>
