---
import { Image } from "astro:assets";
import { ArrowDownToLine } from "lucide-react";
import insightsDark from "../assets/screenshots/slide-2.png";
import insightsLight from "../assets/screenshots/slide-2-l.png";
import {
  getLangFromUrl,
  useTranslatedPath,
  useTranslations,
} from "../i18n/utils";
import { githubRepoUrl } from "../lib/github";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { translatePath } = useTranslatedPath(lang);
---

<section
  id="hero"
  aria-labelledby="hero-heading"
  class="relative overflow-hidden bg-gradient-to-b from-slate-50 to-slate-200 py-16 dark:from-slate-950 dark:to-slate-900 sm:py-24"
>
  <div
    class="absolute inset-0 bg-grid-black/[0.05] dark:bg-grid-white/[0.05] bg-[size:60px_60px]"
  ></div>
  <div class="container relative z-10 mx-auto px-4">
    <div
      class="grid items-center gap-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]"
    >
      <div class="text-center lg:text-left">
        <h1
          id="hero-heading"
          class="mb-6 bg-linear-to-r from-slate-950 via-slate-800 to-violet-600 bg-clip-text font-extrabold text-4xl text-transparent leading-[1.05] tracking-tight dark:from-white dark:via-slate-100 dark:to-violet-300 md:text-5xl lg:text-6xl"
        >
          {t("hero.title")}
        </h1>
        <p
          class="mx-auto mb-8 max-w-2xl text-lg text-slate-700 dark:text-slate-300 md:text-xl lg:mx-0"
        >
          {t("hero.description")}
        </p>
        <div
          class="flex flex-col justify-center gap-4 sm:flex-row lg:justify-start"
        >
          <a
            href={translatePath("/download")}
            class="relative rounded-lg bg-hardviz px-8 py-3 font-medium text-white transition-all hover:bg-[color-mix(in_oklab,var(--primary)_90%,black_10%)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-violet-600 dark:border dark:border-white"
          >
            <div
              class="pointer-events-none absolute inset-0 z-0 bg-hardviz-glow opacity-90 blur-2xl"
            ></div>
            <div
              class="pointer-events-none absolute inset-0 z-0 bg-black/15"
            ></div>
            <div class="flex relative z-10 items-center justify-center gap-2">
              <ArrowDownToLine className="w-5 h-5" />
              {t("hero.download")}
            </div>
          </a>
          <a
            href={githubRepoUrl()}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 rounded-lg border border-slate-300 px-8 py-3 font-medium text-slate-900 transition-all hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-violet-600 dark:border-white/30 dark:text-white dark:hover:bg-white/10"
          >
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              class="h-[18px] w-[18px] fill-current"
            >
              <path
                d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
              />
            </svg>
            {t("hero.viewGitHub")}
          </a>
        </div>
        <p class="mt-4 text-slate-600 text-sm dark:text-slate-400">
          {t("hero.availability")}
        </p>
      </div>
      <div class="relative">
        <figure
          class="overflow-hidden rounded-3xl border border-white/80 bg-white/80 shadow-2xl shadow-slate-900/15 backdrop-blur dark:border-white/10 dark:bg-slate-900/80 dark:shadow-black/40"
        >
          <template id="hero-screenshot-light">
            <Image
              src={insightsLight}
              alt={t("hero.screenshotAlt")}
              class="block h-auto w-full"
              widths={[640, 960, 1280]}
              sizes="(max-width: 1024px) 100vw, 55vw"
              quality={90}
              loading="eager"
            />
          </template>
          <template id="hero-screenshot-dark">
            <Image
              src={insightsDark}
              alt={t("hero.screenshotAlt")}
              class="block h-auto w-full"
              widths={[640, 960, 1280]}
              sizes="(max-width: 1024px) 100vw, 55vw"
              quality={90}
              loading="eager"
            />
          </template>
          <div id="hero-screenshot-slot"></div>
          <noscript>
            <Image
              src={insightsLight}
              alt={t("hero.screenshotAlt")}
              class="block h-auto w-full"
              widths={[640, 960, 1280]}
              sizes="(max-width: 1024px) 100vw, 55vw"
              quality={90}
              loading="eager"
            />
          </noscript>
          <script is:inline>
          (() => {
            const slot = document.getElementById("hero-screenshot-slot");
            if (!slot) return;

            let currentTheme = "";
            const renderForTheme = () => {
              const theme = document.documentElement.classList.contains("dark")
                ? "dark"
                : "light";
              if (theme === currentTheme && slot.childElementCount > 0) return;

              const template = document.getElementById(
                `hero-screenshot-${theme}`,
              );
              if (!(template instanceof HTMLTemplateElement)) return;

              slot.replaceChildren(template.content.cloneNode(true));
              currentTheme = theme;
            };

            renderForTheme();

            const observer = new MutationObserver(renderForTheme);
            observer.observe(document.documentElement, {
              attributes: true,
              attributeFilter: ["class"],
            });
            window.addEventListener("pagehide", () => observer.disconnect(), {
              once: true,
            });
          })();
          </script>
        </figure>
        <div
          class="absolute -right-6 -bottom-6 -z-10 h-72 w-72 rounded-full bg-cyan-400/20 blur-3xl dark:bg-cyan-500/30"
        ></div>
        <div
          class="absolute -top-6 -left-6 -z-10 h-72 w-72 rounded-full bg-purple-400/20 blur-3xl dark:bg-purple-500/20"
        ></div>
      </div>
    </div>
  </div>
</section>
