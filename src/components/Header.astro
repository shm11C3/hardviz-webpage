---
import { Image } from "astro:assets";
import { ArrowDownToLine, Menu } from "lucide-react";
import { FaGithub } from "react-icons/fa";
import logo from "../assets/app-icon.png";
import {
  getLangFromUrl,
  useTranslatedPath,
  useTranslations,
} from "../i18n/utils";
import { githubRepoUrl } from "../lib/github";
import LanguagePicker from "./LanguagePicker.astro";
import ThemeIcon from "./ThemeIcon.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { translatePath } = useTranslatedPath(lang);

const pathname = Astro.url.pathname;
const normalize = (path: string) => (path.endsWith("/") ? path : `${path}/`);
function isCurrent(href: string, section = false): boolean {
  const target = normalize(new URL(href, Astro.url).pathname);
  const current = normalize(pathname);
  return section ? current.startsWith(target) : current === target;
}

const downloadHref = translatePath("/download");
const navLinks = [
  { href: translatePath("/cooling-insight"), label: t("nav.coolingInsight") },
  { href: translatePath("/guide"), label: t("nav.guide") },
  { href: translatePath("/specs"), label: t("nav.compatibility") },
  {
    href: translatePath("/changelog"),
    label: t("nav.changelog"),
    section: true,
  },
  { href: translatePath("/faq"), label: t("nav.faq") },
].map((link) => ({ ...link, current: isCurrent(link.href, link.section) }));
---

<header class="site-header">
  <div class="shell">
    <div class="site-bar">
      <a
        href={translatePath("/")}
        class="flex shrink-0 items-center gap-2.5"
        data-astro-prefetch
      >
        <Image
          src={logo}
          alt=""
          width={28}
          height={28}
          class="h-7 w-7"
          loading="eager"
        />
        <span
          class="font-bold text-[0.8125rem] text-foreground min-[360px]:text-[0.9375rem] sm:text-[1.0625rem]"
          >HardwareVisualizer</span
        >
      </a>

      <div class="flex items-center gap-0 min-[360px]:gap-1.5">
        <nav
          class="mr-2 hidden items-center lg:flex"
          aria-label={t("nav.primaryLabel")}
          data-site-nav
        >
          {navLinks.map((link) => (
            <a
              href={link.href}
              class="site-nav-link"
              data-astro-prefetch
              aria-current={link.current ? "page" : undefined}
            >
              {link.label}
            </a>
          ))}
        </nav>
        <a
          href={githubRepoUrl()}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden h-9 w-9 items-center justify-center rounded-full text-muted-foreground transition-colors hover:text-foreground xl:flex"
          aria-label="GitHub"
          title="GitHub"
        >
          <FaGithub className="h-[18px] w-[18px]" aria-hidden="true" />
        </a>
        <LanguagePicker />
        <ThemeIcon />
        <a
          href={downloadHref}
          class="btn btn-sm btn-primary ml-1 hidden sm:inline-flex"
          data-astro-prefetch
          data-nav-download
          aria-current={isCurrent(downloadHref) ? "page" : undefined}
        >
          <ArrowDownToLine className="h-4 w-4" aria-hidden="true" />
          {t("nav.Download")}
        </a>

        <details class="site-menu relative lg:hidden">
          <summary
            class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-full text-muted-foreground hover:bg-muted hover:text-foreground"
            aria-label={t("nav.menu")}
          >
            <Menu className="h-5 w-5" aria-hidden="true" />
          </summary>
          <nav
            class="absolute top-full right-0 mt-4 w-56 rounded-3xl border border-border bg-popover p-2 text-popover-foreground shadow-xl"
            aria-label={t("nav.menu")}
          >
            <a
              href={downloadHref}
              class="site-menu-link sm:hidden"
              data-astro-prefetch
            >
              {t("nav.Download")}
            </a>
            {navLinks.map((link) => (
              <a
                href={link.href}
                class="site-menu-link"
                data-astro-prefetch
                aria-current={link.current ? "page" : undefined}
              >
                {link.label}
              </a>
            ))}
            <a
              href={githubRepoUrl()}
              target="_blank"
              rel="noopener noreferrer"
              class="site-menu-link"
            >
              GitHub
            </a>
          </nav>
        </details>
      </div>
    </div>
  </div>
</header>

<style>
/* The bar floats over the wallpaper as one translucent pill. */
.site-header {
  position: fixed;
  top: 0.75rem;
  right: 0;
  left: 0;
  z-index: 50;
  pointer-events: none;
}
.site-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  height: 3.5rem;
  padding-inline: 1rem 0.5rem;
  border: 1px solid var(--border);
  border-radius: 9999px;
  background: var(--card);
  -webkit-backdrop-filter: blur(22px) saturate(1.35);
  backdrop-filter: blur(22px) saturate(1.35);
  pointer-events: auto;
}
/* On the narrowest phones the bar keeps every control by tightening up. */
@media (max-width: 359px) {
  .site-bar {
    gap: 0.25rem;
    padding-inline: 0.75rem 0.25rem;
  }
}
.site-nav-link {
  padding: 0.3rem 0.8rem;
  border-radius: 9999px;
  color: var(--muted-foreground);
  font-size: 0.9375rem;
  white-space: nowrap;
  transition: color 150ms;
}
.site-nav-link:hover {
  color: var(--foreground);
}
.site-nav-link[aria-current="page"] {
  background: var(--muted);
  color: var(--foreground);
}
.site-menu > summary::-webkit-details-marker {
  display: none;
}
.site-menu-link {
  display: block;
  padding: 0.5rem 0.9rem;
  border-radius: 9999px;
  font-size: 0.9375rem;
  font-weight: 500;
}
.site-menu-link:hover,
.site-menu-link[aria-current="page"] {
  background: var(--muted);
}
</style>
