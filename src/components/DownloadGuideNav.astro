---
import type { ui } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
import { addJapaneseLineBreaks } from "../lib/japaneseLineBreaks";

interface Props {
  lang: keyof typeof ui;
  current: "download" | "verification";
  downloadHref: string;
  verificationHref: string;
}

const { lang, current, downloadHref, verificationHref } = Astro.props;
const t = useTranslations(lang);
const formatText = (text: string) => addJapaneseLineBreaks(lang, text);

const baseLinkClass =
  "block min-w-0 break-words rounded-md px-2.5 py-2 font-medium transition-colors sm:px-3";
const downloadChildren = [
  {
    href: `${downloadHref}#download`,
    label: formatText(t("download.nav.downloadInstaller")),
  },
  {
    href: `${downloadHref}#installation`,
    label: formatText(t("download.nav.installation")),
  },
] as const;
---

<nav
  class="rounded-2xl border border-border top-28 w-full min-w-0 max-w-full overflow-hidden p-2.5 text-[0.8125rem] sm:p-3 sm:text-sm lg:sticky lg:self-start"
  aria-label={t("download.nav.ariaLabel")}
  data-download-guide-nav
>
  <div class="space-y-1">
    <a
      href={downloadHref}
      class:list={[
        baseLinkClass,
        current === "download"
          ? "bg-muted text-foreground"
          : "text-muted-foreground hover:bg-muted hover:text-foreground",
      ]}
      aria-current={current === "download" ? "page" : undefined}
      data-astro-prefetch
    >
      {formatText(t("download.nav.download"))}
    </a>
    <div
      class="ml-2 min-w-0 space-y-1 border-border border-l pl-2 sm:ml-3 sm:pl-3"
    >
      {downloadChildren.map((item) => (
        <a
          href={item.href}
          class="block min-w-0 break-words rounded-md px-2.5 py-1.5 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground sm:px-3"
          data-astro-prefetch
        >
          {item.label}
        </a>
      ))}
    </div>
    <a
      href={verificationHref}
      class:list={[
        baseLinkClass,
        current === "verification"
          ? "bg-muted text-foreground"
          : "text-muted-foreground hover:bg-muted hover:text-foreground",
      ]}
      aria-current={current === "verification" ? "page" : undefined}
      data-astro-prefetch
    >
      {formatText(t("download.nav.verification"))}
    </a>
  </div>
</nav>
