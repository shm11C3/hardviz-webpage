---
import {
  getLangFromUrl,
  useTranslatedPath,
  useTranslations,
} from "../i18n/utils";
import { githubRepoUrl } from "../lib/github";
import { addJapaneseLineBreaks } from "../lib/japaneseLineBreaks";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { translatePath } = useTranslatedPath(lang);

interface FAQItem {
  question: string;
  answer: string;
  link?: {
    text: string;
    href: string;
  };
}

const faqs: FAQItem[] = [
  {
    question: t("faq.q1"),
    answer: t("faq.a1"),
  },
  {
    question: t("faq.q2"),
    answer: t("faq.a2"),
    link: {
      text: t("faq.verificationGuideLink"),
      href: translatePath("/verification"),
    },
  },
  {
    question: t("faq.q3"),
    answer: t("faq.a3"),
    link: {
      text: t("faq.specsLink"),
      href: translatePath("/specs"),
    },
  },
  {
    question: t("faq.q4"),
    answer: t("faq.a4"),
    link: {
      text: t("faq.compareLink"),
      href: translatePath("/compare"),
    },
  },
  {
    question: t("faq.q5"),
    answer: t("faq.a5"),
  },
  {
    question: t("faq.q6"),
    answer: t("faq.a6"),
    link: {
      text: t("faq.specsLink"),
      href: translatePath("/specs"),
    },
  },
  {
    question: t("faq.q7"),
    answer: t("faq.a7"),
    link: {
      text: t("faq.githubLink"),
      href: `${githubRepoUrl()}/issues`,
    },
  },
];

// FAQPage JSON-LD schema
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<section
  id="faq"
  class:list={["pt-12 pb-20", lang === "ja" && "budoux-ja"]}
  aria-labelledby="faq-heading"
>
  <div class="shell split">
    <div>
      <h1
        id="faq-heading"
        class="font-bold text-3xl text-foreground md:text-4xl"
      >
        {t("faq.title")}
      </h1>
      <p class="mt-4 text-muted-foreground">
        {addJapaneseLineBreaks(lang, t("faq.description"))}
      </p>
    </div>

    <div class="panel ruled min-w-0">
      {faqs.map((faq, index) => (
          <details
            class="faq-item group"
            id={`faq-${index + 1}`}
            open={index === 0}
          >
            <summary>
              <span class="item-title">
                {addJapaneseLineBreaks(lang, faq.question)}
              </span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="faq-chevron"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                aria-hidden="true"
                focusable="false"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.75"
                  d="M19 9l-7 7-7-7"
                />
              </svg>
            </summary>
            <div class="faq-answer">
              <p>{addJapaneseLineBreaks(lang, faq.answer)}</p>
              {faq.link && (
                <a
                  href={faq.link.href}
                  class="link mt-3 inline-block"
                  {...(faq.link.href.startsWith("http")
                    ? { target: "_blank", rel: "noopener noreferrer" }
                    : { "data-astro-prefetch": true })}
                >
                  {faq.link.text}
                </a>
              )}
            </div>
          </details>
        ))}
    </div>
  </div>

  <!-- FAQ JSON-LD -->
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(faqJsonLd).replace(/</g, "\\u003c")}
  />
</section>
