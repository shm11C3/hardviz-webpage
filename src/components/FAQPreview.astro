---
import {
  getLangFromUrl,
  useTranslatedPath,
  useTranslations,
} from "../i18n/utils";
import { addJapaneseLineBreaks } from "../lib/japaneseLineBreaks";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// Japanese copy gets BudouX phrase boundaries so lines break between phrases.
const tf = (key: Parameters<typeof t>[0]) =>
  addJapaneseLineBreaks(lang, t(key));
const { translatePath } = useTranslatedPath(lang);

interface FAQItem {
  question: string;
  answer: string;
}

// Show only top 3 FAQs on homepage
const faqs: FAQItem[] = [
  {
    question: t("faq.q1"),
    answer: t("faq.a1"),
  },
  {
    question: t("faq.q4"),
    answer: t("faq.a4"),
  },
  {
    question: t("faq.q5"),
    answer: t("faq.a5"),
  },
];

// FAQPage JSON-LD schema (for the preview items)
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<section
  id="faq"
  class:list={["section", lang === "ja" && "budoux-ja"]}
  aria-labelledby="faq-heading"
>
  <div class="shell">
    <div class="section-head">
      <h2 id="faq-heading" class="section-title">{tf("faq.title")}</h2>
      <p class="lead">{tf("faq.description")}</p>
    </div>
    <div class="mx-auto mt-[clamp(2rem,4vw,3rem)] max-w-3xl">
      <div class="min-w-0 text-center">
        <div class="panel ruled text-left">
          {faqs.map((faq, index) => (
            <details class="faq-item group" id={`faq-${index + 1}`}>
              <summary>
                <span class="item-title">
                  {addJapaneseLineBreaks(lang, faq.question)}
                </span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="faq-chevron"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.75"
                    d="M19 9l-7 7-7-7"
                  />
                </svg>
              </summary>
              <div class="faq-answer">
                <p>{addJapaneseLineBreaks(lang, faq.answer)}</p>
              </div>
            </details>
          ))}
        </div>
        <a
          href={translatePath("/faq")}
          class="btn btn-outline mt-6"
          data-astro-prefetch
        >
          {tf("faq.viewAll")}
        </a>
      </div>
    </div>
  </div>

  <!-- FAQ JSON-LD -->
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(faqJsonLd).replace(/</g, "\\u003c")}
  />
</section>
