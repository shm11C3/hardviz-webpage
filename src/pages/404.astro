---
// src/pages/404.astro
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import {
  getLangFromUrl,
  useTranslatedPath,
  useTranslations,
} from "../i18n/utils";
import Layout from "../layouts/Layout.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { translatePath } = useTranslatedPath(lang);
---

<Layout
  title="HardwareVisualizer - Lightweight Hardware Monitoring Tool"
  lang={lang}
>
  <Header />
  <main id="main-content" class="pt-28 pb-24">
    <div class="shell">
      <p class="font-mono text-muted-foreground text-sm">404</p>
      <h1
        class="mt-2 font-semibold text-3xl text-foreground tracking-tight md:text-4xl"
      >
        {t("404.title")}
      </h1>
      <p class="mt-4 text-muted-foreground text-lg">{t("404.description")}</p>
      <a href={translatePath("/")} class="btn btn-primary mt-8">
        {t("404.goHome")}
      </a>
    </div>
  </main>
  <Footer />
</Layout>
