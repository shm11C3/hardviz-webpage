---
import Download from "../components/Download.tsx";
import FAQPreview from "../components/FAQPreview.astro";
import Features from "../components/Features.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Insights from "../components/Insights.astro";
import Screenshots from "../components/Screenshots.astro";
import Usage from "../components/Usage.astro";
import { fetchLatestRelease } from "../funcs/fetchReleaseData.ts";
import {
  getLangFromUrl,
  useTranslatedPath,
  useTranslations,
} from "../i18n/utils";
import Layout from "../layouts/Layout.astro";
import { githubAllReleasesUrl, githubLatestReleaseUrl } from "../lib/github";
import { getHomeReleaseNotesDetails } from "../lib/homeReleaseNotes";
import { getLatestReleaseDetails } from "../lib/latestRelease";
import { createPlatformDownloads } from "../lib/platformDownloads";
import { organizationRef, personRef } from "../lib/structuredData";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { translatePath } = useTranslatedPath(lang);

const release = await fetchLatestRelease();
const latestReleaseDetails = await getLatestReleaseDetails({
  version: release.version,
  lang,
  publishedAt: release.published_at,
});
const homeReleaseNotesDetails = await getHomeReleaseNotesDetails({
  lang,
  latestReleaseDetails,
});

const downloads = createPlatformDownloads(release, translatePath("/download"));

const downloadTranslations = {
  title: t("download.title"),
  description: t("download.description"),
  currentVersion: t("download.currentVersion"),
  button: t("download.button"),
  noDownloads: t("download.noDownloads"),
  otherVersions: t("download.otherVersions"),
  changelogLink: t("download.changelogLink"),
  githubDownloadButton: t("download.githubDownloadButton"),
  installationLink: t("download.installationLink"),
  releaseDate: t("download.releaseDate"),
  latestChanges: t("download.latestChanges"),
  latestChangesLink: t("download.latestChangesLink"),
};

// SoftwareApplication JSON-LD for rich search results
const softwareJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "HardwareVisualizer",
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Windows 10, Windows 11, macOS, Linux",
  url: "https://hardviz.com/",
  downloadUrl: githubAllReleasesUrl(),
  softwareVersion: release.version,
  ...(release.published_at ? { dateModified: release.published_at } : {}),
  description:
    "CPU and GPU monitor for Windows that stores configurable long-term CPU, GPU, temperature, and sampled process history locally, helping you review what happened after gaming or heavy workloads. Also available for macOS and Linux.",
  featureList: [
    "Configurable long-term CPU, GPU, temperature, and sampled process history stored locally",
    "Review performance after gaming and heavy workloads",
    "Real-time CPU, GPU, temperature, and memory monitoring",
    "No account and no outbound telemetry",
    "Authenticode-signed Windows release installer",
    "Open-source MIT-licensed software",
    "Windows, macOS, and Linux support",
  ],
  screenshot: "https://hardviz.com/screenshots/slide-1.png",
  author: personRef,
  publisher: organizationRef,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  license: "https://opensource.org/licenses/MIT",
};
---

<Layout
  title="HardwareVisualizer – CPU & GPU Monitor with Long-Term History"
  lang={lang}
  description="CPU & GPU monitoring for Windows with configurable long-term CPU, GPU, temperature, and process history stored locally. Review gaming or heavy workloads afterward."
  ogImageAlt="HardwareVisualizer CPU and GPU monitor with configurable long-term local history"
  jsonLd={softwareJsonLd}
>
  <Header />
  <main id="main-content">
    <Hero />
    <Screenshots />
    <Insights />
    <Features />
    <Usage />
    <Download
      client:visible
      downloads={downloads}
      latestVersion={release.version}
      latestReleaseDetails={latestReleaseDetails}
      releaseNotesDetails={homeReleaseNotesDetails}
      translations={downloadTranslations}
      changelogHref={translatePath("/changelog")}
      githubLatestReleaseHref={githubLatestReleaseUrl()}
      installationHref={`${translatePath("/download")}#installation`}
    />
    <FAQPreview />
  </main>
  <Footer />
</Layout>
